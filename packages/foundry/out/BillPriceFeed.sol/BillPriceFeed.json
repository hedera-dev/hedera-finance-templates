w\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"latestRoundData\",\"outputs\":[{\"internalType\":\"uint80\",\"name\":\"\",\"type\":\"uint80\"},{\"internalType\":\"int256\",\"name\":\"\",\"type\":\"int256\"},{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"},{\"internalType\":\"uint80\",\"name\":\"\",\"type\":\"uint80\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"maturityTimestamp\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"owner\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"updatedAt\",\"type\":\"uint256\"}],\"name\":\"pinUpdatedAt\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"pinnedUpdatedAt\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"price\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"renounceOwnership\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"secondsPerDay\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"rateBps\",\"type\":\"uint256\"}],\"name\":\"setDiscountRate\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"maturityTimestamp_\",\"type\":\"uint256\"}],\"name\":\"setMaturityTimestamp\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"newOwner\",\"type\":\"address\"}],\"name\":\"transferOwnership\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"version\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"pure\",\"type\":\"function\"}],\"devdoc\":{\"details\":\"price = face x (1 - rate x daysRemaining / 360), with 8 decimals. Hedera carries no Treasury price      feed, so this app deploys one; a real feed is a drop-in replacement because both implement      `AggregatorV3Interface`. There is deliberately no setter for the price: a price a desk can type in      proves nothing, and the pull to par has to be arithmetic.      The demo clock lives here and nowhere else: `secondsPerDay` is 10 in the demo and 86400 in production.\",\"errors\":{\"OwnableInvalidOwner(address)\":[{\"details\":\"The owner is not a valid owner account. (eg. `address(0)`)\"}],\"OwnableUnauthorizedAccount(address)\":[{\"details\":\"The caller account is not authorized to perform an operation.\"}]},\"kind\":\"dev\",\"methods\":{\"owner()\":{\"details\":\"Returns the address of the current owner.\"},\"renounceOwnership()\":{\"details\":\"Leaves the contract without owner. It will not be possible to call `onlyOwner` functions. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby disabling any functionality that is only available to the owner.\"},\"transferOwnership(address)\":{\"details\":\"Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner.\"}},\"stateVariables\":{\"YEAR_BPS\":{\"details\":\"Bank-discount convention: a 360-day year, with the rate in basis points.\"}},\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"daysRemaining()\":{\"notice\":\"Whole days left to maturity on the demo clock; 0 once the bill has matured.\"},\"faceValue()\":{\"notice\":\"Face value per bill, in 8-decimal US dollars.\"},\"pinUpdatedAt(uint256)\":{\"notice\":\"Freezes the reported `updatedAt` to a chosen past time, for the staleness simulation. 0 unpins.\"},\"pinnedUpdatedAt()\":{\"notice\":\"When non-zero, `latestRoundData` reports this as `updatedAt` instead of the block time.\"},\"price()\":{\"notice\":\"The price per bill, 8 decimals. A matured bill prices at par; a rate so high that the discount         would exceed the face prices at zero, which a consumer must treat as unusable.\"},\"setMaturityTimestamp(uint256)\":{\"notice\":\"Re-anchors the bill's life. A demo bill matures in about fifteen minutes; this lets the desk start the         clock when it is ready rather than when the feed happened to be deployed.\"}},\"notice\":\"A Treasury bill's price, computed rather than typed in, behind Chainlink's interface.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"contracts/BillPriceFeed.sol\":\"BillPriceFeed\"},\"evmVersion\":\"cancun\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":false,\"runs\":200},\"remappings\":[\":@openzeppelin/contracts/=lib/openzeppelin-contracts/contracts/\",\":ds-test/=lib/solidity-bytes-utils/lib/forge-std/lib/ds-test/src/\",\":erc4626-tests/=lib/openzeppelin-contracts/lib/erc4626-tests/\",\":forge-std/=lib/forge-std/src/\",\":halmos-cheatcodes/=lib/openzeppelin-contracts/lib/halmos-cheatcodes/src/\",\":hedera-forking/=lib/hedera-forking/contracts/\",\":openzeppelin-contracts/=lib/openzeppelin-contracts/\",\":solidity-bytes-utils/=lib/solidity-bytes-utils/contracts/\"]},\"sources\":{\"contracts/BillPriceFeed.sol\":{\"keccak256\":\"0x3e2e62939f4680ea3954ac2f51a4e8fc807c7b81287f06cf3d44a3db75658045\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://b0cf459a2cb1fa7a358fa302f2b62890e1ba4c923811da2d0ecb9060829620bc\",\"dweb:/ipfs/QmY4jtshKFxAwpL6XysuKgMr2cvznKtwHTGh73M3Yvr1ji\"]},\"contracts/interfaces/AggregatorV3Interface.sol\":{\"keccak2