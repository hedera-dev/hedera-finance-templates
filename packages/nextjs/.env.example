NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
NEXT_PUBLIC_HEDERA_MAINNET_RPC_URL=
NEXT_PUBLIC_HEDERA_TESTNET_RPC_URL=

# Bond issuance desk (server-only; never sent to the browser).
# HEDERA_OPERATOR_ID: the issuer's Hedera account id, e.g. 0.0.1234567
# HEDERA_OPERATOR_KEY: the issuer's ECDSA private key (raw hex, with or without 0x, or
#   DER-encoded ECDSA). An ED25519 key is refused at start.
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
